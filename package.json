{
  "name": "memita-4",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "npm run build:bare && expo run:android",
    "ios": "npm run build:bare && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:bare": "tsc -p tsconfig.bare.json && bare-pack --host ios-x86 --host ios-arm --host android-x86 --host android-arm --linked --format bundle.cjs -o ./components/network/bare/bundle.js ./components/network/bare/dist/components/network/bare/index.js && rm -rf ./components/network/bare/dist",
    "node": "tsx ./components/network/hyperswarmNetworkNodeWebsocketServer.ts",
    "hyperswarm-local-bootstrap": "hyperdht --bootstrap --host 127.0.0.1 --port 50000",
    "postinstall": "patch-package && expo prebuild --clean",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint-staged": "lint-staged",
    "ai-translate": "tsx ./update-translations.ts",
    "lingui:extract": "lingui extract --clean",
    "lingui:compile": "lingui compile --strict",
    "desktop": "(cd desktop && npm run dev)",
    "desktop:start": "expo export --platform web --output-dir ./desktop/dist && (cd desktop && npm run start)"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@floating-ui/react-native": "^0.10.9",
    "@jest/globals": "^30.3.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@tanstack/react-query": "^5.90.20",
    "@testing-library/react-native": "^14.0.0-beta.1",
    "@types/gettext-parser": "^9.0.0",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.10",
    "@types/streamx": "^2.9.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vis.gl/react-maplibre": "^8.1.1",
    "bare-buffer": "^3.4.2",
    "bare-encoding": "^1.0.3",
    "bare-pack": "^2.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-plugin-lingui": "^0.13.1",
    "expo": "^55.0.15",
    "expo-build-properties": "~55.0.13",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "^55.0.17",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.13",
    "expo-localization": "~55.0.13",
    "expo-location": "~55.1.8",
    "expo-notifications": "~55.0.19",
    "expo-router": "^55.0.13",
    "expo-splash-screen": "~55.0.18",
    "expo-system-ui": "~55.0.15",
    "expo-updates": "^55.0.21",
    "expo-web-browser": "~55.0.14",
    "get-port": "^7.1.0",
    "gettext-parser": "^9.0.2",
    "husky": "^9.1.7",
    "hyperdht": "^6.30.0",
    "hyperswarm": "^4.16.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "knip": "^6.6.3",
    "lint-staged": "^16.4.0",
    "lodash": "^4.17.23",
    "lucide-react-native": "^1.14.0",
    "magic-bytes.js": "^1.13.0",
    "maplibre-gl": "^5.23.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-native": "0.83.4",
    "react-native-bare-kit": "^0.12.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-quick-base64": "^2.2.2",
    "react-native-quick-crypto": "^1.1.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-web-refresh-control": "^1.1.2",
    "react-native-worklets": "0.7.2",
    "react-qr-code": "^2.0.21",
    "test-renderer": "^1.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testTimeout": 10000,
    "moduleNameMapper": {
      "^expo-modules-core(|/.*)$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core$1"
    },
    "transform": {},
    "transformIgnorePatterns": [],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup.after.ts"
    ]
  },
  "lint-staged": {
    "./**/*.{ts,tsx,js,jsx}": [
      "jest --findRelatedTests --coverage --coverageThreshold='{\"global\":{\"lines\":100,\"functions\":100,\"statements\":100}}' --ci"
    ]
  },
  "devDependencies": {
    "babel-plugin-dynamic-import-node": "^2.3.3"
  }
}
